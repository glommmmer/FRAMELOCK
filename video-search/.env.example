# scripts/init-env.ps1 creates passwords when .env does not exist. Never commit .env.
# Current workspace also loads cloud settings from ../.env. On another machine set them here.
VS_DB_PASSWORD=
VS_MYSQL_ROOT_PASSWORD=
VS_REDIS_PASSWORD=
VS_ADMIN_USER=demo
VS_ADMIN_PASSWORD=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
VISION_MODEL=qwen3-vl-plus
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Local launcher sets VS_DISPATCHER=local, VS_INDEX_MODE=local and disables MQ/Redis.
# launch.ps1 -Infra enables MQ/Redis/Qdrant; API and Worker share one JVM.
# start-full.ps1 provides separate API/Worker containers; that deployment is not yet verified.

VS_STORAGE=minio
VS_MINIO_ENDPOINT=http://127.0.0.1:9000
VS_MINIO_BUCKET=framelock
VS_MINIO_ACCESS_KEY=
VS_MINIO_SECRET_KEY=
# Local OCR requires Tesseract chi_sim + eng; disabled until installed.
VS_OCR_ENABLED=false
TESSERACT_PATH=tesseract

# Tool configuration (existing process environment takes precedence).
# JAVA_HOME=C:/Program Files/Java/jdk-21
# MAVEN_CMD=C:/tools/apache-maven/bin/mvn.cmd
# MAVEN_REPO_LOCAL=C:/package-cache/m2
# VS_WSL_DISTRO=MyUbuntu
# If VS_WSL_DISTRO is absent, the system default WSL distribution is used.
